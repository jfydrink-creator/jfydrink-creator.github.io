---
import { readdirSync } from "node:fs";
import { join } from "node:path";

const images = readdirSync(join(process.cwd(), "public", "images"))
  .filter((f) => /^foto_/i.test(f) && /\.(jpe?g|png|webp|gif)$/i.test(f))
  .sort()
  .map((f) => `/images/${f}`);
---

<section class="section" id="galeria">
  <div class="container">
    <span class="section-eyebrow">Galería</span>
    <h2 class="section-title">Nuestra barra en acción</h2>
    <p class="section-subtitle">
      Así se vive una barra móvil Just For You Drink. Mira nuestras fotos y videos.
    </p>

    <div class="galeria-grid">
      {images.map((src) => (
        <div class="galeria-item">
          <img src={src} alt="Fotografía de la barra móvil en un evento" loading="lazy" />
        </div>
      ))}
    </div>

    <div class="video-section">
      <div class="video-wrap">
        <video controls preload="metadata" poster="/images/logo.png">
          <source src="/videos/video_3.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="video-wrap" style="margin-top: 20px">
        <video controls preload="metadata" poster="/images/logo.png">
          <source src="/videos/video_2.mp4" type="video/mp4" />
        </video>
      </div>
    </div>
  </div>
</section>

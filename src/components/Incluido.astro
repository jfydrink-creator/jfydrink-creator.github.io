---
import { FEATURES } from "../data/site";
---

<section class="section" id="incluido">
  <div class="container">
    <span class="section-eyebrow">Todo incluido</span>
    <h2 class="section-title">Con nosotros no tienes que preocuparte por nada</h2>

    <div class="features-grid">
      {FEATURES.map((f) => (
        <article class="feature">
          <div class="feature-icon">✦</div>
          <h3>{f.title}</h3>
          <p>{f.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

---
import { SITE, CONTACT } from "../data/site";
---

<section class="hero" id="inicio">
  <video class="hero-bg" autoplay muted loop playsinline preload="metadata" poster="/images/logo.png">
    <source src="/videos/video_1.mp4" type="video/mp4" />
  </video>

  <div class="hero-content">
    <span class="hero-badge">Eventos y bodas · Cataluña</span>
    <h1 class="hero-title">{SITE.name}</h1>
    <p class="hero-sub">{SITE.tagline}</p>
    <div class="hero-actions">
      <a
        class="btn btn-primary"
        href={`https://wa.me/${CONTACT.whatsapp}?text=${encodeURIComponent(CONTACT.whatsappMessage)}`}
        target="_blank"
        rel="noopener"
      >
        Pide tu presupuesto
      </a>
      <a class="btn btn-outline" href="#packs">Ver packs y precios</a>
    </div>
  </div>
</section>
